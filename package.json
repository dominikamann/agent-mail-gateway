{
  "name": "agent-mail-gateway",
  "version": "0.1.2",
  "description": "Self-hosted email gateway that gives each AI agent its own mailbox with allow-list filtering, Markdown conversion, calendar invites, REST and MCP access.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run"
  },
  "author": "dominikamann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ical-generator": "^11.1.2",
    "imapflow": "^2.2.1",
    "mailparser": "^3.9.33",
    "marked": "^18.0.14",
    "nodemailer": "^10.0.13",
    "pino": "^10.4.0",
    "sanitize-html": "^2.18.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "openapi-types": "^12.1.3",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/dominikamann/agent-mail-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominikamann/agent-mail-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/dominikamann/agent-mail-gateway/issues"
  },
  "keywords": [
    "email",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "imap",
    "smtp",
    "email-gateway",
    "markdown",
    "calendar",
    "icalendar",
    "self-hosted",
    "hermes-agent"
  ]
}
